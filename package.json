{
  "name": "18bites",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@18bites/api & npm run dev --workspace=@18bites/web",
    "dev:api": "npm run dev --workspace=@18bites/api",
    "dev:web": "npm run dev --workspace=@18bites/web",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@18bites/db",
    "db:migrate": "npm run migrate --workspace=@18bites/db",
    "db:seed": "npm run seed --workspace=@18bites/db",
    "db:push": "npm run push --workspace=@18bites/db"
  },
  "engines": {
    "node": ">=18"
  }
}
